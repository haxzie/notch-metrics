# Copy to apps/api/.dev.vars, which is gitignored. Wrangler loads it for
# `wrangler dev` and for the tests; the deployed Worker gets these through
# `wrangler secret put <NAME> --env production` instead.
#
# Non-secret configuration — the URLs, the Dodo product ids, the active KEK
# version — lives in wrangler.jsonc, not here.

# `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Authorised redirect URIs to register on the Google OAuth client:
#
#   http://localhost:8787/api/auth/callback/google
#   https://api.notchmetrics.com/api/auth/callback/google
#
# Both point at the *API*, not the website: Better Auth derives the callback
# from API_URL + basePath, so a redirect URI built from the site's origin is
# rejected by Google as a mismatch. The port is why wrangler.jsonc pins
# dev.port to 8787 — a wrangler that walked to 8788 sends Google's callback
# to whatever else is holding 8787.
#
# No "Authorised JavaScript origin" is needed; the exchange is server-side.
#
# Leave both empty to run without Google sign-in — email sign-in is enabled
# automatically when API_URL is not production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub sign-in. An **OAuth App** (Settings → Developer settings → OAuth
# Apps), not a GitHub App: a GitHub App's user token is scoped to its
# installations and brings an installation flow with it, which buys nothing
# when all we want is an identity.
#
# Authorization callback URL — one per app, so this is two apps:
#
#   http://localhost:8787/api/auth/callback/github
#   https://api.notchmetrics.com/api/auth/callback/github
#
# The API's origin, not the site's, for the same reason as Google above.
#
# Nothing to do with the GitHub *connector*: that reads a repository with a
# token the user pastes in themselves and needs no app and no secret here.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The GitHub *connector* — reading stars, forks and open work from a
# repository. A second OAuth App, not the sign-in one above: different
# callback, different scopes, revoked independently. Sharing one would mean
# signing in silently granted repository access.
#
# Authorization callback URL:
#
#   http://localhost:8787/v1/link/oauth/callback
#   https://api.notchmetrics.com/v1/link/oauth/callback
#
# Scopes are requested by the adapter (public_repo, read:user) and are not
# configured here.
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# The key that wraps every user's provider credentials. 32 bytes, base64:
#
#     openssl rand -base64 32
#
# Must be valid base64 of exactly 32 bytes. A placeholder that is not valid
# base64 fails inside atob(), so every crypto test *errors* rather than fails,
# and the message points at the decoder instead of at this line.
#
# Rotation adds INTEGRATION_KEK_V2 and bumps INTEGRATION_KEK_ACTIVE; see
# scripts/rotate-kek.ts. Never delete a version while any row still names it —
# those integrations become permanently unreadable and there is no backup of a
# user's Stripe key.
INTEGRATION_KEK_V1=

# Dodo Payments. The product and brand ids are not secret and live in
# wrangler.jsonc; these two are.
#
# The webhook key is the `whsec_…` signing key under Developer → Webhooks, not
# the API key. Without it the webhook route refuses every call, which is
# deliberate: an unsigned POST to it could set any user's plan.
DODOPAYMENT_API_KEY=
DODOPAYMENT_WEBHOOK_SECRET=

# Error reporting. Absent means errors go to the console only, which is a
# working local state rather than a broken one.
SENTRY_DSN=

# Slack incoming webhooks, one per channel: signups go to the first, the
# connection lifecycle to the second. See apps/api/src/lib/slack.ts.
#
# Create them under Slack → Apps → Incoming Webhooks; a webhook URL *is* the
# credential and is bound to one channel, so moving a notification to a
# different channel means a new URL, not a code change.
#
# Leave empty to run without them — an unconfigured channel is a silent
# no-op, which is what every test run and most dev stacks want.
SLACK_WEBHOOK_SIGNUPS=
SLACK_WEBHOOK_EVENTS=
