{
  "name": "@notch/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist --env=\"\"",
    "deploy": "wrangler deploy --env production",
    "migrate": "wrangler d1 migrations apply notch --local",
    "migrate:remote": "wrangler d1 migrations apply notch --remote --env production",
    "reset": "rm -rf .wrangler/state/v3/d1 && pnpm migrate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo node_modules dist .wrangler *.tsbuildinfo"
  },
  "dependencies": {
    "@notch/db": "workspace:*",
    "@notch/integrations": "workspace:*",
    "@notch/schemas": "workspace:*",
    "better-auth": "^1.2.7",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.15",
    "standardwebhooks": "^1.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.19",
    "@cloudflare/workers-types": "^5.20261001.1",
    "@notch/typescript-config": "workspace:*",
    "typescript": "^5.7.2",
    "vitest": "2.1.8",
    "wrangler": "^4.40.0"
  }
}
