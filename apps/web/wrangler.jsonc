{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notch-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  // OpenNext's output depends on Node built-ins, and the flag below is what
  // lets the bundled Next server start at all.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "env": {
    "production": {
      "routes": [{ "pattern": "notchmetrics.com", "custom_domain": true }],
      "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },

      // The same shipper the API uses. This site is a Worker like any other
      // once OpenNext has built it, so its trace events go to Axiom without
      // a line of Next.js instrumentation — no `@axiomhq/nextjs`, no SDK
      // making an HTTP call on the request path, nothing in the client
      // bundle. What arrives is the HTTP log: method, masked path, status
      // and outcome per request, which is most of what there is to know
      // about a site that calls `console` once in its whole source.
      //
      // `-production` because a named environment deploys as `<name>-<env>`.
      // Cloudflare accepts a consumer that does not exist and then delivers
      // nothing, so the only symptom of a typo here is an empty dataset.
      "tail_consumers": [{ "service": "notch-logs-production" }]
    }
  }
}
