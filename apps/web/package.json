{
  "name": "@notch/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env production",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next .open-next .turbo node_modules *.tsbuildinfo"
  },
  "dependencies": {
    "@notch/env": "workspace:*",
    "@notch/schemas": "workspace:*",
    "better-auth": "^1.7.7",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@notch/typescript-config": "workspace:*",
    "@opennextjs/cloudflare": "^1.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "react-grab": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.40.0"
  }
}
