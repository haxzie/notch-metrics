{
  "name": "@notchmetrics/mcp",
  "version": "0.2.0",
  "description": "MCP server for authoring local Notch Metrics connectors and custom metrics.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "notchmetrics-mcp": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "node build.mjs --watch",
    "build": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo node_modules dist *.tsbuildinfo"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@notch/metric-runtime": "workspace:*",
    "@notch/schemas": "workspace:*",
    "@notch/typescript-config": "workspace:*",
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haxzie/notch-metrics.git",
    "directory": "apps/mcp"
  },
  "keywords": [
    "mcp",
    "notch-metrics",
    "metrics",
    "macos",
    "model-context-protocol"
  ]
}
