{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notch-logs",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-30",

  // No routes and no triggers on purpose. This Worker is only ever invoked by
  // the runtime delivering another Worker's trace events, so giving it a
  // public hostname would be an endpoint with nothing behind it.

  // Its own logs stay in Workers Logs rather than going to Axiom: a log
  // shipper that ships its own failures through itself cannot report the
  // outage that matters. `wrangler tail notch-logs-production` is the way in.
  "observability": { "enabled": true },

  // One dataset, used by both environments. There is no dev deployment of
  // this Worker — `wrangler dev` has no token and drops events — so a second
  // dataset would only be a name that does not exist.
  "vars": {
    "AXIOM_DATASET": "notch-metrics-api",
    "AXIOM_API_URL": "https://api.axiom.co"
  },

  "env": {
    "production": {
      "vars": {
        // The dataset's real name in Axiom. Getting this wrong is not an
        // error you see from here: a name that does not exist answers 404
        // `dataset not found`, and a token scoped to a different one answers
        // 403 `not allowed to ingest into dataset` — both of which read like
        // a bad token, and neither of which reaches anything but this
        // Worker's own logs.
        "AXIOM_DATASET": "notch-metrics-api",
        // An EU Axiom organisation uses https://api.eu.axiom.co. Getting this
        // wrong is a 401 that reads like a bad token.
        "AXIOM_API_URL": "https://api.axiom.co"
      }
      // AXIOM_TOKEN is a secret:
      //   pnpm --filter @notch/logs exec wrangler secret put AXIOM_TOKEN --env production
      // Without it this Worker accepts events and drops them, which is what
      // a preview deployment should do.
    }
  }
}
