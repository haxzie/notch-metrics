# Copy to .env (gitignored). `pnpm install` does this for you.
#
# These are for Node and Next only. The Worker's configuration lives in
# apps/api/wrangler.jsonc (non-secret) and apps/api/.dev.vars (secret) —
# reading process.env inside a Worker returns undefined with no error, which
# is the worst shape a configuration bug can take.
#
# The defaults below point at `pnpm dev`, so a fresh clone runs with no edits.

NEXT_PUBLIC_APP_NAME="Notch Metrics"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_ASSETS_URL=http://localhost:8787

# Product analytics. The project token is write-only and served to every
# browser that loads the site, so it is not a secret. Absent means no analytics,
# which is a working state rather than a broken one.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Error reporting.
NEXT_PUBLIC_SENTRY_DSN=
