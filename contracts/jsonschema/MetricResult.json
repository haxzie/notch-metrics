{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "series": {
          "type": "object",
          "properties": {
            "integrationId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ]
            },
            "metric": {
              "type": "string"
            },
            "unit": {
              "type": "string",
              "enum": [
                "currency",
                "count",
                "ratio",
                "duration",
                "bytes"
              ]
            },
            "currency": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 3,
                  "pattern": "^[A-Z]{3}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "value": {
              "type": "number"
            },
            "previousValue": {
              "type": [
                "number",
                "null"
              ]
            },
            "delta": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "absolute": {
                      "type": "number"
                    },
                    "percent": {
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "absolute",
                    "percent"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "points": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "t": {
                    "type": "string"
                  },
                  "v": {
                    "type": "number"
                  }
                },
                "required": [
                  "t",
                  "v"
                ],
                "additionalProperties": false
              }
            },
            "granularity": {
              "type": "string",
              "enum": [
                "hour",
                "day",
                "week",
                "month"
              ]
            },
            "range": {
              "type": "string",
              "enum": [
                "24h",
                "7d",
                "30d",
                "90d",
                "12m"
              ]
            },
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            },
            "format": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "decimals": {
                      "default": 0,
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4
                    },
                    "compact": {
                      "default": true,
                      "type": "boolean"
                    },
                    "prefix": {
                      "default": "",
                      "type": "string",
                      "maxLength": 3
                    },
                    "suffix": {
                      "default": "",
                      "type": "string",
                      "maxLength": 4
                    }
                  },
                  "required": [
                    "decimals",
                    "compact",
                    "prefix",
                    "suffix"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "generatedAt": {
              "type": "string"
            },
            "stale": {
              "default": false,
              "type": "boolean"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "t": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "detail": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "amount": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "currency": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 3,
                        "pattern": "^[A-Z]{3}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "status": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "id",
                  "t",
                  "label",
                  "detail",
                  "amount",
                  "currency",
                  "status"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "integrationId",
            "metric",
            "unit",
            "currency",
            "value",
            "previousValue",
            "delta",
            "points",
            "granularity",
            "range",
            "from",
            "to",
            "format",
            "generatedAt",
            "stale"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ok",
        "series"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": false
        },
        "integrationId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "metric": {
          "type": "string"
        },
        "code": {
          "type": "string",
          "enum": [
            "auth_failed",
            "rate_limited",
            "provider_down",
            "unsupported",
            "not_found",
            "stale"
          ]
        },
        "message": {
          "type": "string"
        },
        "retryAfterSeconds": {
          "default": null,
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ok",
        "integrationId",
        "metric",
        "code",
        "message",
        "retryAfterSeconds"
      ],
      "additionalProperties": false
    }
  ]
}
