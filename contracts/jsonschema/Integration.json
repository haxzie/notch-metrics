{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "provider": {
      "type": "string",
      "enum": [
        "stripe",
        "dodopayments",
        "lemonsqueezy",
        "polar",
        "paddle",
        "revenuecat",
        "posthog",
        "plausible",
        "mixpanel",
        "amplitude",
        "google-analytics",
        "google-search-console",
        "ahrefs",
        "google-ads",
        "meta-ads",
        "hubspot",
        "intercom",
        "github"
      ]
    },
    "label": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "auth_failed",
        "rate_limited",
        "disabled"
      ]
    },
    "credentialHint": {
      "type": "string"
    },
    "accountLabel": {
      "type": [
        "string",
        "null"
      ]
    },
    "accountCurrency": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 3,
          "maxLength": 3,
          "pattern": "^[A-Z]{3}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "enabledMetrics": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "mrr",
          "arr",
          "revenue",
          "one_time_sales",
          "refunds",
          "active_subscribers",
          "new_subscribers",
          "churned_subscribers",
          "trials",
          "recent_payments",
          "visitors",
          "pageviews",
          "sessions",
          "active_users",
          "new_users",
          "events",
          "bounce_rate",
          "conversion_rate",
          "clicks",
          "impressions",
          "ctr",
          "average_position",
          "backlinks",
          "domain_rating",
          "organic_keywords",
          "ad_spend",
          "ad_conversions",
          "stars",
          "forks",
          "open_issues",
          "open_pull_requests",
          "contacts",
          "new_contacts",
          "open_deals",
          "won_deals",
          "pipeline_value",
          "open_conversations"
        ]
      }
    },
    "availableMetrics": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "mrr",
          "arr",
          "revenue",
          "one_time_sales",
          "refunds",
          "active_subscribers",
          "new_subscribers",
          "churned_subscribers",
          "trials",
          "recent_payments",
          "visitors",
          "pageviews",
          "sessions",
          "active_users",
          "new_users",
          "events",
          "bounce_rate",
          "conversion_rate",
          "clicks",
          "impressions",
          "ctr",
          "average_position",
          "backlinks",
          "domain_rating",
          "organic_keywords",
          "ad_spend",
          "ad_conversions",
          "stars",
          "forks",
          "open_issues",
          "open_pull_requests",
          "contacts",
          "new_contacts",
          "open_deals",
          "won_deals",
          "pipeline_value",
          "open_conversations"
        ]
      }
    },
    "lastSyncedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "lastErrorAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "lastErrorCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "provider",
    "label",
    "status",
    "credentialHint",
    "accountLabel",
    "accountCurrency",
    "enabledMetrics",
    "availableMetrics",
    "lastSyncedAt",
    "lastErrorAt",
    "lastErrorCode",
    "createdAt"
  ],
  "additionalProperties": false
}
