{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rows": {
      "default": 2,
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "widgets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "kind": {
            "type": "string",
            "enum": [
              "provider_metric",
              "custom_metric",
              "divider"
            ]
          },
          "appId": {
            "default": "unknown",
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "integrationId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ]
          },
          "metric": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "mrr",
                  "arr",
                  "revenue",
                  "one_time_sales",
                  "refunds",
                  "active_subscribers",
                  "new_subscribers",
                  "churned_subscribers",
                  "trials",
                  "recent_payments",
                  "visitors",
                  "pageviews",
                  "sessions",
                  "active_users",
                  "new_users",
                  "events",
                  "bounce_rate",
                  "conversion_rate",
                  "clicks",
                  "impressions",
                  "ctr",
                  "average_position",
                  "ad_spend",
                  "ad_conversions",
                  "subscribers",
                  "views",
                  "watch_time",
                  "average_view_duration",
                  "likes",
                  "comments",
                  "ad_revenue",
                  "rpm",
                  "stars",
                  "forks",
                  "open_issues",
                  "open_pull_requests",
                  "followers",
                  "contacts",
                  "new_contacts",
                  "open_deals",
                  "won_deals",
                  "pipeline_value",
                  "open_conversations"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "customMetricId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 60
              },
              {
                "type": "null"
              }
            ]
          },
          "size": {
            "default": "2x1",
            "type": "string",
            "pattern": "^[1-6]x[1-4]$"
          },
          "col": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "row": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "position": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "granularity": {
            "default": "day",
            "type": "string",
            "enum": [
              "hour",
              "day",
              "week",
              "month"
            ]
          },
          "range": {
            "default": "30d",
            "type": "string",
            "enum": [
              "24h",
              "7d",
              "30d",
              "90d",
              "12m"
            ]
          },
          "params": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,31}$"
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 200
            }
          },
          "chart": {
            "default": "sparkline",
            "type": "string",
            "enum": [
              "none",
              "sparkline",
              "bars"
            ]
          },
          "visible": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "kind",
          "appId",
          "integrationId",
          "metric",
          "customMetricId",
          "title",
          "size",
          "col",
          "row",
          "position",
          "granularity",
          "range",
          "params",
          "chart",
          "visible"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "revision",
    "rows",
    "widgets"
  ],
  "additionalProperties": false
}
