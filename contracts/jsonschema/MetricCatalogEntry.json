{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "integrationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "provider": {
      "type": "string"
    },
    "accountLabel": {
      "type": [
        "string",
        "null"
      ]
    },
    "metric": {
      "type": "string",
      "enum": [
        "mrr",
        "arr",
        "revenue",
        "one_time_sales",
        "refunds",
        "active_subscribers",
        "new_subscribers",
        "churned_subscribers",
        "trials",
        "recent_payments",
        "visitors",
        "pageviews",
        "sessions",
        "active_users",
        "new_users",
        "events",
        "bounce_rate",
        "conversion_rate",
        "clicks",
        "impressions",
        "ctr",
        "average_position",
        "backlinks",
        "domain_rating",
        "organic_keywords",
        "ad_spend",
        "ad_conversions",
        "stars",
        "forks",
        "open_issues",
        "open_pull_requests",
        "contacts",
        "new_contacts",
        "open_deals",
        "won_deals",
        "pipeline_value",
        "open_conversations"
      ]
    },
    "label": {
      "type": "string"
    },
    "shortLabel": {
      "type": "string"
    },
    "unit": {
      "type": "string",
      "enum": [
        "currency",
        "count",
        "ratio",
        "duration",
        "bytes"
      ]
    },
    "currency": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 3,
          "maxLength": 3,
          "pattern": "^[A-Z]{3}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "granularities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "hour",
          "day",
          "week",
          "month"
        ]
      }
    },
    "supportsSeries": {
      "type": "boolean"
    }
  },
  "required": [
    "integrationId",
    "provider",
    "accountLabel",
    "metric",
    "label",
    "shortLabel",
    "unit",
    "currency",
    "granularities",
    "supportsSeries"
  ],
  "additionalProperties": false
}
