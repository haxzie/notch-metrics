{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "accountLabel": {
      "type": [
        "string",
        "null"
      ]
    },
    "currency": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 3,
          "maxLength": 3,
          "pattern": "^[A-Z]{3}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "availableMetrics": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "mrr",
          "arr",
          "revenue",
          "refunds",
          "active_subscribers",
          "new_subscribers",
          "churned_subscribers",
          "trials",
          "visitors",
          "pageviews",
          "sessions",
          "active_users",
          "new_users",
          "events",
          "bounce_rate",
          "conversion_rate",
          "clicks",
          "impressions",
          "ctr",
          "average_position",
          "backlinks",
          "domain_rating",
          "organic_keywords",
          "ad_spend",
          "ad_conversions",
          "stars",
          "forks",
          "open_issues",
          "open_pull_requests",
          "contacts",
          "new_contacts",
          "open_deals",
          "won_deals",
          "pipeline_value",
          "open_conversations"
        ]
      }
    },
    "code": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "message": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "ok",
    "accountLabel",
    "currency",
    "availableMetrics",
    "code",
    "message"
  ],
  "additionalProperties": false
}
