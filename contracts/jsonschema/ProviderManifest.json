{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "enum": [
        "stripe",
        "dodopayments",
        "lemonsqueezy",
        "polar",
        "paddle",
        "revenuecat",
        "posthog",
        "plausible",
        "mixpanel",
        "amplitude",
        "google-analytics",
        "google-search-console",
        "ahrefs",
        "google-ads",
        "meta-ads",
        "hubspot",
        "intercom",
        "github"
      ]
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "revenue",
        "analytics",
        "marketing",
        "crm",
        "developer"
      ]
    },
    "tagline": {
      "type": "string"
    },
    "docsUrl": {
      "type": "string",
      "format": "uri"
    },
    "iconPath": {
      "type": "string"
    },
    "accentColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authMode": {
      "type": "string",
      "enum": [
        "api_key",
        "oauth2"
      ]
    },
    "oauth": {
      "type": "object",
      "properties": {
        "scopeSummary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requiresSelection": {
          "default": false,
          "type": "boolean"
        },
        "selectionLabel": {
          "type": "string"
        }
      },
      "required": [
        "scopeSummary",
        "requiresSelection"
      ],
      "additionalProperties": false
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "secret",
              "select",
              "url",
              "boolean"
            ]
          },
          "required": {
            "default": true,
            "type": "boolean"
          },
          "placeholder": {
            "type": "string"
          },
          "help": {
            "type": "string"
          },
          "pattern": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "value",
                "label"
              ],
              "additionalProperties": false
            }
          },
          "default": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "label",
          "type",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "metrics": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "mrr",
              "arr",
              "revenue",
              "refunds",
              "active_subscribers",
              "new_subscribers",
              "churned_subscribers",
              "trials",
              "recent_payments",
              "visitors",
              "pageviews",
              "sessions",
              "active_users",
              "new_users",
              "events",
              "bounce_rate",
              "conversion_rate",
              "clicks",
              "impressions",
              "ctr",
              "average_position",
              "backlinks",
              "domain_rating",
              "organic_keywords",
              "ad_spend",
              "ad_conversions",
              "stars",
              "forks",
              "open_issues",
              "open_pull_requests",
              "contacts",
              "new_contacts",
              "open_deals",
              "won_deals",
              "pipeline_value",
              "open_conversations"
            ]
          },
          "label": {
            "type": "string"
          },
          "shortLabel": {
            "type": "string",
            "maxLength": 12
          },
          "unit": {
            "type": "string",
            "enum": [
              "currency",
              "count",
              "ratio",
              "duration",
              "bytes"
            ]
          },
          "granularities": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "hour",
                "day",
                "week",
                "month"
              ]
            }
          },
          "supportsSeries": {
            "type": "boolean"
          },
          "supportsCompare": {
            "type": "boolean"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "help": {
            "type": "string"
          },
          "methodology": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "shortLabel",
          "unit",
          "granularities",
          "supportsSeries",
          "supportsCompare",
          "methodology"
        ],
        "additionalProperties": false
      }
    },
    "allowedHosts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "stable",
        "beta",
        "coming_soon"
      ]
    },
    "minAppVersion": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "category",
    "tagline",
    "docsUrl",
    "iconPath",
    "accentColor",
    "authMode",
    "fields",
    "metrics",
    "allowedHosts",
    "status",
    "minAppVersion"
  ],
  "additionalProperties": false
}
