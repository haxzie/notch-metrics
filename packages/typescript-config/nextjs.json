{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    // Next's own build re-resolves these, and `rewriteRelativeImportExtensions`
    // fights the `@/` alias, so the two flags the other configs rely on are off
    // here. Imports in apps/web carry no extension, like every other Next app.
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": false
  }
}
