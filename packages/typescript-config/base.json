{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",

    "strict": true,
    // Indexing an array or a Record yields `T | undefined`. It is the single
    // most valuable strictness flag and also the most irritating: it is why the
    // test suites carry a `scalar()` helper to unwrap a known-present row.
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,

    // Imports are erased exactly as written. Combined with the two flags below
    // this is what lets the Worker and vitest run the TypeScript sources
    // directly, with no build step and no path rewriting.
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "exclude": ["node_modules", "dist", ".turbo"]
}
